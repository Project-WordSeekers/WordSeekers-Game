script = ExtResource("scroll_npc")
speaker_name = "Guardião do Conhecimento"
dialogue_text = "Receba o Pergaminho do Conhecimento (Scroll of Knowledge). Na mochila, ele mostra a porcentagem dos habitantes com quem você já conversou e quantos monstros já encontrou. Para recuperar todos os fragmentos da língua inglesa, converse com todos os habitantes e encontre os 100 monstros do mapa. Mesmo se perder uma batalha, o encontro conta. Ao completar os dois objetivos, volte ao mapa-múndi para o confronto final."

