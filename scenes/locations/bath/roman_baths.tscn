speaker_name = "Roman Baths Attendant"
dialogue_text = "Salve, traveler! Welcome to the Roman Baths. The hot spring water comes from deep underground, and the Romans believed the goddess Sulis Minerva gave it healing powers. Step into the warm pools to restore your strength."

