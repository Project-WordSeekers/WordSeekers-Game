; Banhos romanos de Bath. Substitui o interior de templo compartilhado nesta cidade.
; Room tem a imagem (1452x1083) com canto superior esquerdo na origem e escala
; 2048/1452, para ocupar a mesma área do templo padrão. Por isso os polígonos e
; áreas dentro de Room usam diretamente coordenadas em pixels da imagem.
[node name="TempleBath" type="Node2D"]
script = ExtResource("1_bath")
temple_zoom = 1.0

[node name="TileMapLayer" type="TileMapLayer" parent="."]
scale = Vector2(0.75, 0.75)

[node name="Room" type="Node2D" parent="TileMapLayer"]
position = Vector2(-1024, -763.76)
scale = Vector2(1.41047, 1.41047)

[node name="Background" type="Sprite2D" parent="TileMapLayer/Room"]
texture_filter = 2
texture = ExtResource("2_bg")
centered = false

[node name="Obstacles" type="StaticBody2D" parent="TileMapLayer/Room"]
collision_layer = 1
collision_mask = 0

; Parede norte: estátuas, estandartes, braseiros e fonte de Sulis Minerva.
[node name="NorthWall" type="CollisionPolygon2D" parent="TileMapLayer/Room/Obstacles"]
polygon = PackedVector2Array(-50, -50, 1502, -50, 1502, 298, -50, 298)

; Colunata oeste, bancos/ânforas do degrau inferior e pedestal do braseiro esquerdo.
[node name="WestSide" type="CollisionPolygon2D" parent="TileMapLayer/Room/Obstacles"]
polygon = PackedVector2Array(-50, 298, 275, 298, 195, 770, 117, 780, 117, 852, 584, 852, 592, 1048, 592, 1133, -50, 1133)

; Colunata leste, bancos/ânforas do degrau inferior e pedestal do braseiro direito.
[node name="EastSide" type="CollisionPolygon2D" parent="TileMapLayer/Room/Obstacles"]
polygon = PackedVector2Array(1177, 298, 1502, 298, 1502, 1133, 858, 1133, 858, 1048, 866, 852, 1335, 852, 1335, 780, 1257, 770)

; Abaixo da escadaria de saída.
[node name="SouthEdge" type="CollisionPolygon2D" parent="TileMapLayer/Room/Obstacles"]
polygon = PackedVector2Array(592, 1048, 858, 1048, 858, 1133, 592, 1133)

; Água das piscinas: ao entrar, a vida é restaurada (ver roman_bath.gd).
