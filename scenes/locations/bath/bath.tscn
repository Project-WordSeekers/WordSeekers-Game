[node name="LessonNPC1" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(715.0, 930.0)
npc_id = "bath_lesson_1"
speaker_name = "Auxiliar das termas — Partes do corpo"
dialogue_text = "Head é cabeça, shoulders são ombros, knees são joelhos e feet são pés. Foot é um pé; feet é o plural."

[node name="Sprite2D" parent="LessonNPC1" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_cidadao6")

[node name="LessonNPC2" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(835.0, 930.0)
npc_id = "bath_lesson_2"
speaker_name = "Visitante das termas — Saúde e bem-estar"
dialogue_text = "My head hurts significa que minha cabeça dói. I feel tired significa que estou cansado. Rest e drink water são instruções de cuidado."

[node name="Sprite2D" parent="LessonNPC2" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_idosa1")

[node name="LessonNPC3" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(775.0, 870.0)
npc_id = "bath_lesson_3"
speaker_name = "Visitante — Leitura sobre bem-estar"
dialogue_text = "Leia a fala da visitante. Que parte do corpo ela menciona e o que pretende fazer?\n\nMy feet hurt after the walk. I need to sit down and rest."
script = ExtResource("reading_lesson")
review_text = "Ela menciona os pés e quer sentar para descansar."

