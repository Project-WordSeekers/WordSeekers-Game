[node name="CrescentGuide" parent="NPCs" instance=ExtResource("99_npc")]
position = Vector2(330, 205)
speaker_name = "Royal Crescent Guide"
dialogue_text = "Welcome to Bath! These elegant houses form the Royal Crescent, built in the 1770s. Bath is famous for its golden stone, its Roman Baths and the writer Jane Austen, who lived here. Explore the Abbey, the Baths and Pulteney Bridge!"
npc_id = "bath_crescent_guide"

[node name="BathsAttendant" parent="NPCs" instance=ExtResource("99_npc")]
position = Vector2(170, 640)
speaker_name = "Roman Baths Attendant"
dialogue_text = "Salve, traveler! The Romans built these baths almost two thousand years ago. The hot spring water comes from deep underground, and they dedicated the temple here to the goddess Sulis Minerva."
npc_id = "bath_baths_attendant"

