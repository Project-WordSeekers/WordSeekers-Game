[node name="NPCs" type="Node2D" parent="."]

; Sprites provisórios (reaproveitados de outras cidades) até haver arte própria.
; Plymouth Hoe: Sir Francis Drake, no calçadão ao lado da estátua.
[node name="Drake" parent="NPCs" instance=ExtResource("99_npc")]
position = Vector2(800, 122)
dialogue_text = "Olá, WordSeeker! Sou Sir Francis Drake. Aquela é minha estátua em Plymouth Hoe. Em 1577, parti a bordo do Golden Hind e dei a volta ao mundo. Voltei em 1580. Dizem que eu jogava boliche de gramado antes de enfrentar a Armada Espanhola. Veja o farol vermelho e branco. É a Torre de Smeaton."
speaker_name = "Sir Francis Drake"
npc_id = "plymouth_drake"

[node name="Sprite2D" parent="NPCs/Drake" index="0"]
scale = Vector2(0.151, 0.151)
texture = ExtResource("103_drake_tex")

; Mayflower Steps: capitão do Mayflower, em frente ao arco.
[node name="Captain" parent="NPCs" instance=ExtResource("99_npc")]
position = Vector2(1222, 446)
dialogue_text = "Bom dia, WordSeeker! Sou o capitão Christopher Jones. Em setembro de 1620, o Mayflower saiu de Plymouth com 102 passageiros. Cruzamos o Atlântico em 66 dias. Esses passageiros ficaram conhecidos como Peregrinos. Fundaram um povoado chamado Plymouth, como esta cidade."
speaker_name = "Captain Christopher Jones"
npc_id = "plymouth_captain"

[node name="CityMusic" type="AudioStreamPlayer" parent="."]
stream = ExtResource("90_city_theme")
autoplay = true
script = ExtResource("91_city_music_loop")

[node name="LessonNPC1" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(650.0, 810.0)
npc_id = "plymouth_lesson_1"
speaker_name = "Trabalhador do porto — Bilhete de embarque"
dialogue_text = "Board at the east pier before noon. East pier identifica o cais leste e before noon indica antes do meio-dia."

[node name="Sprite2D" parent="LessonNPC1" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_pescador")

[node name="LessonNPC2" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(578.0, 858.0)
npc_id = "plymouth_lesson_2"
speaker_name = "Atendente do cais — Tabela de partidas"
dialogue_text = "North pier: 10:00. East pier: 11:30. West pier: 13:00. Para embarcar no cais leste antes do meio-dia, use a partida das 11:30."

[node name="Sprite2D" parent="LessonNPC2" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_cidadao5")

[node name="LessonNPC3" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(722.0, 858.0)
npc_id = "plymouth_lesson_3"
speaker_name = "Vigia do porto — Leitura e mudança de rota"
dialogue_text = "Leia o anúncio e descubra para qual cais vai o passageiro.\n\nThe east pier is closed. Passengers for the eleven thirty boat should go to the north pier."
script = ExtResource("reading_lesson")
review_text = "O passageiro deve ir ao cais norte."

[node name="Sprite2D" parent="LessonNPC3" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_guarda2")

[node name="LessonNPC4" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(614.0, 738.0)
npc_id = "plymouth_lesson_4"
speaker_name = "Viajante — Inglês e diversidade"
dialogue_text = "Nesta viagem, uma pessoa fala português e outra fala japonês. Elas podem usar inglês para confirmar o cais e o horário sem compartilhar a mesma língua materna."

