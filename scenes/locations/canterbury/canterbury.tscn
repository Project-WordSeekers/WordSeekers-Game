position = Vector2(785, 981)
speaker_name = "Guia de Canterbury"
npc_id = "canterbury_town_guide"
dialogue_text = "Boas-vindas a Canterbury! Em inglês, cathedral significa catedral. Consegue localizar a catedral no mapa?"

[node name="LessonNPC1" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(675.0, 1000.0)
npc_id = "canterbury_lesson_1"
speaker_name = "Guia de viajantes — Inglês como língua franca"
dialogue_text = "Imagine viajantes do Brasil e do Japão. Eles podem usar inglês para se entender mesmo quando nenhum deles cresceu falando inglês."

