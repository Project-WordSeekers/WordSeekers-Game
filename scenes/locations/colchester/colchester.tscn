[node name="HelpInventoryGuide" type="Area2D" parent="NPCs"]
position = Vector2(1210, 391)
script = ExtResource("201_help_guide_script")
speaker_name = "Guia de Colchester"
dialogue_text = "Olá, WordSeeker! Quer uma dica para sua jornada?\n\nPressione H para abrir a Ajuda. Lá você pode consultar os comandos e as orientações do jogo. Pressione H novamente para fechar.\n\nPressione I para abrir sua Mochila. Nela você encontra os itens que recebeu, como O Dicionário, e pode conferir quantos usos ainda restam. Pressione I novamente para fechar.\n\nDesde que os monstros apareceram, ficou muito difícil manter contato com as outras cidades. As estradas já não são seguras, e estamos perdendo a oportunidade de compartilhar o que sabemos sobre o idioma inglês.\n\nVocê pode consultar a Ajuda e a Mochila durante sua exploração. Boa viagem!"
npc_id = "colchester_guia_ajuda_mochila"

