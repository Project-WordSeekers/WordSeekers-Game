[node name="CronistaRomano" parent="NPCs" instance=ExtResource("roman_historian")]
position = Vector2(960, 660)
speaker_name = "Cronista de Colchester"
npc_id = "colchester_cronista_romano"
dialogue_text = "Na época dos romanos, Colchester era conhecida como Camulodunum. Os romanos adotaram esse nome de origem celta, que significa fortaleza de Camulos. Em 49 d.C., fundaram aqui a Colonia Claudia, que se tornou a primeira capital da Britânia romana.\n\nQuando sair de Colchester, siga para Cambridge pelo mapa-múndi. Há boatos de que ainda vivem lá pessoas que se lembram do inglês. Procure os moradores perto da ponte matemática. Talvez eles possam ensinar o que ainda sabem."
