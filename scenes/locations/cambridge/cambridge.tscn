[node name="BridgeMultiplier" type="CharacterBody2D" parent="."]
position = Vector2(995, 870)
script = ExtResource("12_bridge_npc")
npc_id = "cambridge_bridge_multiplier"
speaker_name = "Carpinteira da ponte"
lesson = Array[String](["Para dizer quantas vezes uma ação acontece, usamos once (uma vez), twice (duas vezes) e three times (três vezes).", "Compare three taps (três batidas), the third tap (a terceira batida) e tap three times (bata três vezes). A primeira conta, a segunda indica posição e a terceira diz quantas vezes repetir."])
question = "Qual instrução pede para bater duas vezes?"
answers = Array[String](["Tap twice.", "Tap once.", "Tap three times."])
correct_answer = 0
explanation = "Tap twice significa bata duas vezes."

