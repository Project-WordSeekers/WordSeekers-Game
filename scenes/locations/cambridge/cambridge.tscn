[node name="BridgeGuide" type="CharacterBody2D" parent="." unique_id=1871776737]
position = Vector2(651, 698)
script = ExtResource("12_bridge_npc")
npc_id = "cambridge_bridge_guide"
speaker_name = "Guia da ponte"
lesson = Array[String](["Os cardinais indicam quantidade. Vamos contar de 0 a 10.\n0 zero · 1 one · 2 two · 3 three · 4 four · 5 five\n6 six · 7 seven · 8 eight · 9 nine · 10 ten", "Agora, de 11 a 20.\n11 eleven · 12 twelve · 13 thirteen · 14 fourteen · 15 fifteen\n16 sixteen · 17 seventeen · 18 eighteen · 19 nineteen · 20 twenty", "As dezenas são 30 thirty, 40 forty, 50 fifty, 60 sixty, 70 seventy, 80 eighty e 90 ninety. Use hífen para combinar dezenas e unidades. 23 é twenty-three.", "100 é one hundred e 1.000 é one thousand. No inglês britânico, 105 é one hundred and five. Juntando tudo, 999 é nine hundred and ninety-nine."])
question = "O inventário marca 40 tábuas. Como você diz essa quantidade em inglês?"
answers = Array[String](["Fourteen", "Forty", "Four hundred"])
correct_answer = 1
explanation = "Forty significa 40. Fourteen significa 14."

