[node name="BridgeOrdinal" type="CharacterBody2D" parent="."]
position = Vector2(528, 693)
script = ExtResource("12_bridge_npc")
npc_id = "cambridge_bridge_ordinal"
speaker_name = "Aprendiz de carpintaria"
lesson = Array[String](["Os ordinais indicam posição. A contagem começa em first. Zeroth (0th) aparece em contextos técnicos.\n1st first · 2nd second · 3rd third · 4th fourth · 5th fifth", "6th sixth · 7th seventh · 8th eighth · 9th ninth · 10th tenth\n11th eleventh · 12th twelfth · 13th thirteenth · 14th fourteenth · 15th fifteenth", "16th sixteenth · 17th seventeenth · 18th eighteenth · 19th nineteenth · 20th twentieth\nEm 21st, só a última parte vira ordinal. Twenty-first.", "30th thirtieth · 40th fortieth · 50th fiftieth · 60th sixtieth\n70th seventieth · 80th eightieth · 90th ninetieth\n100th one hundredth · 1,000th one thousandth"])
question = "A marca numa tábua é 21st. Como você lê essa posição em inglês?"
answers = Array[String](["Twenty-one", "Twentieth", "Twenty-first"])
correct_answer = 2
explanation = "Twenty-first indica a 21ª posição. Twenty-one indica a quantidade 21."

