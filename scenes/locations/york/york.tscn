[node name="GuardiaoDaLupa" parent="." instance=ExtResource("npc_lupa")]
position = Vector2(510, 1018)
script = ExtResource("script_lupa")
npc_id = "york_guardiao_da_lupa"
speaker_name = "Guardião de York"
dialogue_text = "Leve esta Lupa. No caça-palavras, clique em Usar Lupa para destacar a primeira letra de uma palavra que você ainda não encontrou. Depois, selecione a palavra inteira no tabuleiro. A Lupa tem três usos. Você pode consultar o saldo na mochila."

[node name="LessonNPC1" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(510.0, 1188.0)
npc_id = "york_lesson_1"
speaker_name = "Guia de York — To be afirmativo"
dialogue_text = "I am a guide, she is a doctor e they are visitors. Am acompanha I, is acompanha he, she ou it, e are acompanha you, we ou they."

[node name="Sprite2D" parent="LessonNPC1" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_cidadao5")

[node name="LessonNPC2" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(438.0, 1140.0)
npc_id = "york_lesson_2"
speaker_name = "Visitante — To be negativo e interrogativo"
dialogue_text = "She is not a guide é negativo. Faça a pergunta colocando is antes do sujeito. Is she a guide? Yes, she is. No, she isn't."

[node name="Sprite2D" parent="LessonNPC2" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_nobre6")

[node name="LessonNPC3" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(582.0, 1140.0)
npc_id = "york_lesson_3"
speaker_name = "Guarda — Leitura e inferência"
dialogue_text = "Leia a fala do visitante. Pelo contexto, de que ajuda ele precisa?\n\nI have a ticket, but I cannot find the entrance."
script = ExtResource("reading_lesson")
review_text = "O visitante precisa de ajuda para achar a entrada."

[node name="Sprite2D" parent="LessonNPC3" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_guarda1")

[node name="LessonNPC4" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(510.0, 1272.0)
npc_id = "york_lesson_4"
speaker_name = "Estudiosa — Variação do inglês"
dialogue_text = "No inglês britânico, lift pode significar elevador. No inglês americano, elevator é comum. São formas diferentes de pedir o mesmo serviço."

