npc_id = "royal_albert_office_lesson_4"
speaker_name = "Viajante — Conectores de sequência"
dialogue_text = "First, show your ticket. Then, find the gate. After that, wait for the call. Finally, board the boat. As palavras destacam a ordem das ações."

