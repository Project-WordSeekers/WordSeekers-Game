[node name="LessonNPC1" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(704.0, 825.0)
npc_id = "royal_albert_office_lesson_1"
speaker_name = "Agente portuário — Tabela de embarques"
dialogue_text = "Leia por linha: Star — York — 09:00. Rose — Bristol — 11:00. O navio para Bristol é o Rose, e o horário é 11:00."

[node name="Sprite2D" parent="LessonNPC1" index="0"]
texture_filter = 1
