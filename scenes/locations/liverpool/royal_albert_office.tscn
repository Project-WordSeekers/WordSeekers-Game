[node name="LessonNPC2" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(824.0, 825.0)
npc_id = "royal_albert_office_lesson_2"
speaker_name = "Escrivã — Bilhete e tabela"
dialogue_text = "Seu bilhete diz Bristol after ten. Compare com a tabela do agente. O Rose sai às 11:00 e atende às duas condições."

[node name="Sprite2D" parent="LessonNPC2" index="0"]
texture_filter = 1
scale = Vector2(1, 1)
texture = ExtResource("lesson_art_cidadao2")

[node name="LessonNPC3" parent="." instance=ExtResource("lesson_npc")]
position = Vector2(764.0, 765.0)
npc_id = "royal_albert_office_lesson_3"
speaker_name = "Responsável pelos avisos — Leitura de horários"
dialogue_text = "Leia e descubra qual horário você anotaria no quadro.\n\nThe Rose usually leaves at eleven. Today it is leaving at twelve because of the fog."
script = ExtResource("reading_lesson")
review_text = "Hoje o Rose sai às doze. Onze é o horário habitual."

[node name="Sprite2D" parent="LessonNPC3" index="0"]
texture_filter = 1
