[node name="Content" type="Label" parent="HUD/HelpOverlay/Panel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 17
text = "Setas / WASD — mover\nE — interagir / confirmar\nH — abrir ou fechar esta ajuda\nI — abrir ou fechar a mochila\nT (Translate) — usar O Dicionário durante quizzes\n\nHP (Health Points): você começa com 10. Em batalhas, cada erro no quiz remove 1 HP. Ao chegar a 0 HP, você retorna à Cidade 01.\n\nO Dicionário possui 3 usos e revela a resposta correta da pergunta atual."
autowrap_mode = 2

[node name="Close" type="Label" parent="HUD/HelpOverlay/Panel/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.8, 1)
text = "Pressione H para fechar"
horizontal_alignment = 2

